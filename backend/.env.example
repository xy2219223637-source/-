# OpenAI Compatible API Configuration
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o
LLM_VISION_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1024
EMBEDDING_MODE=standard
# 未配置真实模型前保持开启，可离线跑通完整生成流程
LLM_MOCK_MODE=true
LLM_DISABLE_THINKING=true
LLM_TIMEOUT_SECONDS=90
GENERATION_MAX_ATTEMPTS=3
MAX_UPLOAD_MB=25
DIRECTOR_VIDEO_MAX_UPLOAD_MB=300
DIRECTOR_CAPTURE_SESSION_MINUTES=10
DIRECTOR_SCENE_THRESHOLD=0.36
DIRECTOR_MIN_SHOT_SECONDS=0.65
DIRECTOR_VISION_BATCH_SIZE=4
DIRECTOR_FFMPEG_PATH=
DIRECTOR_FFPROBE_PATH=
DIRECTOR_KEYFRAME_MIN_COUNT=3
DIRECTOR_KEYFRAME_MAX_COUNT=5
DIRECTOR_ASR_PROVIDER=auto
DIRECTOR_ASR_REQUIRED=false
DIRECTOR_ASR_API_BASE=
# 在豆包语音控制台创建, 不能使用方舟模型推理 API Key 替代
DIRECTOR_ASR_API_KEY=
DIRECTOR_ASR_MODEL=whisper-1
DIRECTOR_ASR_LANGUAGE=zh
DIRECTOR_ASR_RESOURCE_ID=volc.seedasr.auc
DIRECTOR_ASR_POLL_INTERVAL_SECONDS=1.5
DIRECTOR_ASR_POLL_TIMEOUT_SECONDS=180
AUTH_SECRET=replace-with-a-long-random-secret

# 千川授权（默认关闭；真实联调前在平台登记完全相同的回调地址）
QIANCHUAN_ENABLED=false
# 默认记录素材接口脱敏 JSON 和中文指标明细；false 仅保留摘要
QIANCHUAN_LOG_MATERIAL_RESPONSE=true
QIANCHUAN_APP_ID=
QIANCHUAN_APP_SECRET=
# 填应用后台确认的官方授权地址；scope 按获批权限填写
QIANCHUAN_AUTHORIZATION_URL=
QIANCHUAN_SCOPE=
QIANCHUAN_TOKEN_ENCRYPTION_KEY=
# 本地 HTTP 仅 DEBUG=true 时允许；Docker 本地入口改为 8080
QIANCHUAN_REDIRECT_URI=http://127.0.0.1:5173/api/qianchuan/oauth/callback
ACCESS_TOKEN_HOURS=24

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# PostgreSQL（密码中的特殊字符需 URL 编码）
DATABASE_URL=postgresql+psycopg://canvas_app_user:replace-me@121.199.52.72:5432/enrui_ai_commerce_agent
REQUIRE_POSTGRES=true
REQUIRE_ONLINE_SERVICES=true
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800

# Redis（当前实例无密码；正式使用前建议设置密码并限制来源 IP）
REDIS_URL=redis://121.199.52.72:6379/0
REDIS_KEY_PREFIX=enrui-ai-commerce-agent:

# Storage：文件直接保存到 OSS，本地仅使用系统临时缓存
STORAGE_PROVIDER=aliyun_oss
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET_NAME=commerce-agent-raw
ALIYUN_OSS_PREFIX=enrui-ai-commerce-agent/
# Optional per-tenant private video storage. Comma-separated tenant IDs or codes.
# Images and tenants not listed here continue to use Aliyun OSS.
PRIVATE_VIDEO_TENANTS=
# Prefer a separately mounted secret file containing S3_ENDPOINT/S3_PUBLIC_ENDPOINT,
# S3_AK/S3_SK/S3_BUCKET/S3_REGION. Direct settings below are also supported.
PRIVATE_VIDEO_S3_ENV_FILE=
PRIVATE_VIDEO_S3_ENDPOINT=
PRIVATE_VIDEO_S3_PUBLIC_ENDPOINT=
PRIVATE_VIDEO_S3_ACCESS_KEY_ID=
PRIVATE_VIDEO_S3_ACCESS_KEY_SECRET=
PRIVATE_VIDEO_S3_BUCKET_NAME=
PRIVATE_VIDEO_S3_REGION=us-east-1
PRIVATE_VIDEO_S3_PREFIX=enrui-ai-commerce-agent/
STORAGE_CACHE_DIR=
STORAGE_CACHE_MAX_GB=20
STORAGE_CACHE_TTL_HOURS=24
IMAGE_GENERATION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_GENERATION_MODEL=
IMAGE_PRODUCT_MODEL=
IMAGE_PORTRAIT_MODEL=
IMAGE_EDIT_MODEL=
IMAGE_UPSCALE_MODEL=
GENERATION_PARAMETER_VERSION=commerce-image-v2
# 商品蒙版、保护区与生成后二次合成；功能闭环完善前保持关闭
PRODUCT_PROTECTION_ENABLED=false
APPROVAL_WEBHOOK_URL=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_TIMEOUT_SECONDS=240
IMAGE_GENERATION_WATERMARK=false

# 火山方舟账单同步（使用企业已开通的账单查询代理/API地址）
VOLC_BILLING_API_URL=
VOLC_BILLING_API_TOKEN=
VOLC_BILLING_ACCOUNT_ID=
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_LLM_MODEL=
ARK_VIDEO_MODEL=doubao-seedance-1-0-pro-250528
ARK_VIDEO_RESOLUTION=720p
VIDEO_MODEL_PROVIDER=volcengine-ark

DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_TOKEN=
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_SPEAKER=zh_female_shuangkuaisisi_uranus_bigtts
DOUBAO_TTS_SPEAKER_MALE=zh_male_m191_uranus_bigtts
AUTO_EDIT_AUDIO_MODE=smart_mix
WHISPER_ENABLED=true
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
# Feishu notifications: credentials enable access for one system enterprise.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
APP_PUBLIC_BASE_URL=
# Optional: credentials enable notifications automatically. Set false to disable.
# FEISHU_ENABLED=false
# Optional: required only when multiple active system enterprises exist.
# FEISHU_SYSTEM_TENANT_ID=
# Optional: defaults to backend/logs/YYYY-MM-DD (Beijing date; .log summaries and .raw.log details).
# FEISHU_LOG_DIR=
# FEISHU_LOG_RAW=true
