# Copy to backend/.env and fill in your values

# Qianchuan OAuth: disabled until real application credentials/callback are configured.
# Local HTTP callback requires DEBUG=true; production uses its registered HTTPS URL.
QIANCHUAN_ENABLED=false
QIANCHUAN_LOG_MATERIAL_RESPONSE=true
QIANCHUAN_PLAN_ENABLED=false
QIANCHUAN_PLAN_WRITE_ENABLED=false
QIANCHUAN_PLAN_WORKER_ENABLED=false
QIANCHUAN_APP_ID=
QIANCHUAN_APP_SECRET=
QIANCHUAN_AUTHORIZATION_URL=
QIANCHUAN_REDIRECT_URI=http://127.0.0.1:5173/api/qianchuan/oauth/callback
QIANCHUAN_SCOPE=
QIANCHUAN_TOKEN_ENCRYPTION_KEY=

# OpenAI Compatible API Configuration
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o
LLM_VISION_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# AI-assisted rejected-video diagnosis. Keep disabled until a compatible
# multimodal model and API key are configured.
VIDEO_REPAIR_AI_ENABLED=false
VIDEO_REPAIR_AI_PROVIDER=openai_compatible
VIDEO_REPAIR_AI_MODEL=
VIDEO_REPAIR_AI_TIMEOUT_SECONDS=45
VIDEO_REPAIR_AI_MAX_KEYFRAMES=12
VIDEO_REPAIR_AI_PROMPT_VERSION=video-repair-diagnosis-v2
VIDEO_REPAIR_CONTEXT_PRE_MS=4000
VIDEO_REPAIR_CONTEXT_POST_MS=4000
VIDEO_REPAIR_CONTEXT_MAX_MS=8000
VIDEO_REPAIR_RECOMMEND_SCORE=0.75
VIDEO_REPAIR_SELECTABLE_SCORE=0.60
VIDEO_REPAIR_V4_ENABLED=false
VIDEO_REPAIR_ASYNC_WORKER_ENABLED=false
VIDEO_REPAIR_MULTIMODAL_ENABLED=false
VIDEO_REPAIR_AUDIO_REPLACE_ENABLED=false
VIDEO_REPAIR_CONTENT_INSERT_ENABLED=false
VIDEO_REPAIR_IMAGE_MOTION_ENABLED=false

# Director video analysis
DIRECTOR_VIDEO_MAX_UPLOAD_MB=300
DIRECTOR_CAPTURE_SESSION_MINUTES=10
DIRECTOR_SCENE_THRESHOLD=0.36
DIRECTOR_MIN_SHOT_SECONDS=0.65
DIRECTOR_VISION_BATCH_SIZE=4
DIRECTOR_FFMPEG_PATH=
DIRECTOR_FFPROBE_PATH=
DIRECTOR_KEYFRAME_MIN_COUNT=3
DIRECTOR_KEYFRAME_MAX_COUNT=5
DIRECTOR_ASR_PROVIDER=auto
DIRECTOR_ASR_REQUIRED=false
DIRECTOR_ASR_API_BASE=
# Create this key in the Doubao Speech console. Ark inference keys are not interchangeable.
DIRECTOR_ASR_API_KEY=
DIRECTOR_ASR_MODEL=whisper-1
DIRECTOR_ASR_LANGUAGE=zh
DIRECTOR_ASR_RESOURCE_ID=volc.seedasr.auc
DIRECTOR_ASR_POLL_INTERVAL_SECONDS=1.5
DIRECTOR_ASR_POLL_TIMEOUT_SECONDS=180
DIRECTOR_ASR_LOCAL_DEVICE=auto
DIRECTOR_ASR_LOCAL_COMPUTE_TYPE=int8

# Server
# Optional: run only the ecommerce video queue when other background workers are disabled.
# RUN_ECOMMERCE_VIDEO_ANALYSIS_WORKER=true
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Cloud persistence (local SQLite and upload storage are not supported)
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
REQUIRE_POSTGRES=true
STORAGE_PROVIDER=aliyun_oss
PRODUCT_PROTECTION_ENABLED=false
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET_NAME=
# Feishu notifications: credentials enable access for one system enterprise.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
APP_PUBLIC_BASE_URL=
# Optional: credentials enable notifications automatically. Set false to disable.
# FEISHU_ENABLED=false
# Optional: required only when multiple active system enterprises exist.
# FEISHU_SYSTEM_TENANT_ID=
# Optional: defaults to backend/logs/YYYY-MM-DD (Beijing date; .log summaries and .raw.log details).
# FEISHU_LOG_DIR=
# FEISHU_LOG_RAW=true

# Shared enterprise credits MVP. See docs/billing_mvp_runbook.md.
BILLING_ENABLED=false
BILLING_MOCK_ENABLED=false
BILLING_TEST_ISOLATION=false
BILLING_GRANT_MAX_CREDITS=100000
BILLING_GRANT_RATE_LIMIT=10
BILLING_RESERVATION_SECONDS=1800
