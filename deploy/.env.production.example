# PostgreSQL / Redis
DATABASE_URL=postgresql+psycopg://canvas_app_d416715b:FILL_PASSWORD@121.199.52.72:5432/enrui_ai_commerce_agent
REQUIRE_POSTGRES=true
REQUIRE_ONLINE_SERVICES=true
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
REDIS_URL=redis://121.199.52.72:6379/0
REDIS_KEY_PREFIX=enrui-ai-commerce-agent:

# Aliyun OSS
STORAGE_PROVIDER=aliyun_oss
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=FILL_ROTATED_ACCESS_KEY_ID
ALIYUN_OSS_ACCESS_KEY_SECRET=FILL_ROTATED_ACCESS_KEY_SECRET
ALIYUN_OSS_BUCKET_NAME=commerce-agent-raw
ALIYUN_OSS_PREFIX=enrui-ai-commerce-agent/

# Auth — generate with: openssl rand -hex 32
AUTH_SECRET=FILL_RANDOM_AUTH_SECRET
ACCESS_TOKEN_HOURS=24

# Model services
LLM_API_BASE=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=FILL_ARK_API_KEY
LLM_MODEL=FILL_ARK_TEXT_MODEL_ENDPOINT_ID
LLM_VISION_MODEL=FILL_ARK_VISION_MODEL_ENDPOINT_ID
LLM_MOCK_MODE=false
DIRECTOR_VIDEO_MAX_UPLOAD_MB=300
DIRECTOR_CAPTURE_SESSION_MINUTES=10
DIRECTOR_FFMPEG_PATH=/usr/bin/ffmpeg
DIRECTOR_FFPROBE_PATH=/usr/bin/ffprobe
DIRECTOR_SCENE_THRESHOLD=0.36
DIRECTOR_ASR_PROVIDER=auto
DIRECTOR_ASR_API_KEY=FILL_DOUBAO_SPEECH_API_KEY
DIRECTOR_ASR_RESOURCE_ID=volc.seedasr.auc
IMAGE_GENERATION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_GENERATION_API_KEY=FILL_IMAGE_API_KEY
IMAGE_GENERATION_MODEL=FILL_IMAGE_MODEL
IMAGE_GENERATION_TIMEOUT_SECONDS=240
IMAGE_GENERATION_WATERMARK=false

HOST=0.0.0.0
PORT=8000
DEBUG=false
UPLOAD_DIR=/tmp/enrui-uploads
# Feishu notifications: credentials enable access for one system enterprise.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
APP_PUBLIC_BASE_URL=
# Optional: credentials enable notifications automatically. Set false to disable.
# FEISHU_ENABLED=false
# Optional: required only when multiple active system enterprises exist.
# FEISHU_SYSTEM_TENANT_ID=
# Docker Compose persists logs by Beijing date in its feishu_logs volume at /app/logs/YYYY-MM-DD.
# Optional: false keeps summaries and omits request/response bodies.
# FEISHU_LOG_RAW=true
