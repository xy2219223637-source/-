  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ModelKey": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      },
      "OrderId": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      },
      "PositiveCredits": {
        "type": "string",
        "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,4})?$",
        "maxLength": 24,
        "description": "必须大于零，转换至 1/10000 积分后不溢出 int64；不能用数值类型或科学计数法。"
      },
      "Credits": {
        "type": "string",
        "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{4}$",
        "maxLength": 24
      },
      "TokenDecimal": {
        "type": "string",
        "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,6})?$",
        "maxLength": 17,
        "description": "折算 Token 精确值，最大 1000000000；不用二进制浮点。"
      },
      "RawMetric": {
        "type": "string",
        "enum": [
          "image_count",
          "audio_milliseconds",
          "character_count"
        ]
      },
      "MetricRate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metric": {
            "type": "string",
            "enum": [
              "input_tokens",
              "output_tokens",
              "converted_tokens"
            ]
          },
          "unit_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "credits_per_unit": {
            "$ref": "#/components/schemas/PositiveCredits"
          }
        },
        "required": [
          "metric",
          "unit_size",
          "credits_per_unit"
        ]
      },
      "Conversion": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_metric": {
            "$ref": "#/components/schemas/RawMetric"
          },
          "source_unit_size": {
            "type": "integer",
            "enum": [
              1,
              10,
              100,
              1000,
              10000,
              100000,
              1000000
            ]
          },
          "tokens_per_unit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
