            }
          },
          {
            "name": "model_type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "TEXT",
                "VISION",
                "IMAGE",
                "EMBEDDING",
                "TTS",
                "ASR",
                "VIDEO"
